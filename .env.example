# Copy this file to .env.local for local development, then restart Next.js.
# NEXT_PUBLIC_* values are visible in the browser. Never place secrets here.

# Backend Express API base URL, including /api/v1; no trailing slash.
# Match the backend PORT and use the same hostname (localhost or 127.0.0.1)
# as backend FRONTEND_URL so credentialed CORS and cookies work correctly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Reversible frontend client-demo guard. Keep true until payment QA is approved.
NEXT_PUBLIC_CLIENT_DEMO=true

# MongoDB, JWT, admin seed credentials, R2 credentials and payment secrets
# belong only in the backend .env. R2 image URLs are returned by the API;
# no frontend R2 environment variable is required.
